<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The system's swipe-to-dismiss would close the whole app from any menu. It is switched off and the app handles the swipe itself
         (MainActivity.dispatchTouchEvent): inside a menu it goes back one step, and only from the main screen does it leave the app. -->
    <style name="KyTheme" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowSwipeToDismiss">false</item>
    </style>
</resources>

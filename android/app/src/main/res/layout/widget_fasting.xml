<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fast_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.14"
            android:text="FASTING"
            android:textColor="#FFFF5500"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fast_protocol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="16:8 Standard"
            android:textColor="#FF9A9A9A"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Chronometer
        android:id="@+id/fast_timer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif-condensed"
        android:includeFontPadding="false"
        android:textColor="#FFFFFFFF"
        android:textSize="40sp"
        android:textStyle="bold|italic" />

    <TextView
        android:id="@+id/fast_idle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif-condensed"
        android:includeFontPadding="false"
        android:text="NOT FASTING"
        android:textColor="#FF6B6B6B"
        android:textSize="32sp"
        android:textStyle="bold|italic"
        android:visibility="gone" />

    <TextView
        android:id="@+id/fast_stage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Fat burning · goal 8:30 PM"
        android:textColor="#FF8A8A8A"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/fast_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0"
        android:progressBackgroundTint="#33FFFFFF"
        android:progressTint="#FFFF5500" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/fast_action"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/widget_btn_primary"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:text="START FAST"
            android:textColor="#FF000000"
            android:textSize="16sp"
            android:textStyle="bold|italic" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/eat_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_eat_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.14"
        android:text="EAT"
        android:textColor="#FFE9CB8E"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/eat_left"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="serif"
        android:includeFontPadding="false"
        android:text="0"
        android:textColor="#FFFBF1E8"
        android:textSize="40sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/eat_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="left to enjoy"
        android:textColor="#FFCBBABE"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/eat_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0"
        android:progressBackgroundTint="#33FFE2D6"
        android:progressTint="#FFF2475F" />

    <TextView
        android:id="@+id/eat_macro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text=""
        android:textColor="#FFCBBABE"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/eat_add"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_eat_btn_primary"
            android:gravity="center"
            android:text="Log food"
            android:textColor="#FF1E0A10"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/eat_water"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_eat_btn"
            android:gravity="center"
            android:text="+8 oz water"
            android:textColor="#FFFBF1E8"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>

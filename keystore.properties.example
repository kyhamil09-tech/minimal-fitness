# Copy this file to keystore.properties (same folder) and fill it in. keystore.properties is git-ignored: never commit or share it.
# The keystore itself should live outside this project folder, with a backup in a password manager or other safe place.
# If you lose the upload key you can ask Google to reset it, but only if Play App Signing is on.
storeFile=C:\\Users\\YOU\\keys\\ky-fitness-upload.keystore
storePassword=
keyAlias=upload
keyPassword=
